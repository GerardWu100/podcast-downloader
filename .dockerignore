.venv/
__pycache__/
*.pyc
.git/
.DS_Store

# Runtime state. The Dockerfile uses "COPY . ." and the entrypoint creates these
# under the mounted data directory, so copying a developer's live queue, logs and
# sessions into the image would both leak them and be immediately overwritten.
# .env is deliberately not listed: the Dockerfile seeds /data/.env from it on first boot.
downloads/
urls.txt
downloaded_urls.txt
bypass_age_check_urls.txt
download.log
activity.log
.ui_sessions.json
.ui_credentials.json
.ui_sessions.json.lock
.direct-download.lock
.downloaded_urls.txt.download.lock
.login_state.json
.login_state.json.lock

# Not needed at runtime
extension/
tests/
scripts/
blog/
docs/
