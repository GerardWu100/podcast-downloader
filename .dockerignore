.venv/
__pycache__/
*.pyc
.git/
.DS_Store

# Runtime state and secrets. The Dockerfile uses explicit copies as the primary
# boundary; these exclusions also keep private files out of the build context.
.env
.env.*
!.env.example
cookies.txt
www.youtube.com_cookies.txt
*.cookies
notifications.json
downloads/
urls.txt
downloaded_urls.txt
bypass_age_check_urls.txt
download.log
activity.log
.ui_sessions.json
.ui_credentials.json
.ui_sessions.json.lock
.direct-download.lock
.downloaded_urls.txt.download.lock
.login_state.json
.login_state.json.lock

# Not needed at runtime. The container runs the server; nothing here is
# imported by src/, start.py, or docker-entrypoint.sh.
extension/
tests/
scripts/
blog/
docs/

# Generated output. `build/` holds the assembled browser extensions and their
# archives, written by scripts/build_extensions.py. It is browser code and can
# be several hundred kilobytes, so it does not belong in the build context.
.amo-credentials
build/
dist/
