# Web UI login accounts. Copy this file to .env and set at least the first
# account. On startup the app hashes each UI_PASSWORD with PBKDF2, verifies the
# hash, and stores only the hashes in .ui_credentials.json. You never run a
# hashing command yourself.

# Account name typed into the web UI login form.
UI_USERNAME=admin

# Plain-text password. Change this before exposing the UI.
UI_PASSWORD=changeme

# Optional second and third accounts. Every account can do the same things;
# they exist to give separate people separate passwords. Leave a slot blank to
# skip it, set both values to use it, and keep the account names different.
UI_USERNAME_2=
UI_PASSWORD_2=
UI_USERNAME_3=
UI_PASSWORD_3=

# Docker only. Folders on your machine behind the container's /data,
# /downloads, and /temporary paths. Docker Compose reads them from the .env
# beside docker-compose.yml; the application itself never reads them. Leave a
# value blank to use the default shown in the comment, and give a full path,
# not one starting with ~, because Docker Compose does not expand ~ here.

# Settings, queue, logs, and sign-in state. Default ${HOME}/.containers/podcast-downloader
PODCAST_DATA_HOST_DIR=

# Finished MP3 files. Default ${HOME}/downloads/podcasts
PODCAST_DOWNLOADS_HOST_DIR=

# Partly downloaded files while a download runs. Default ${HOME}/downloads/temporary
PODCAST_TEMP_HOST_DIR=
