# Web UI login. Copy this file to .env and set both values.
# On startup the app hashes UI_PASSWORD with PBKDF2, verifies the hash,
# and stores only the hash in .ui_credentials.json. You never run a
# hashing command yourself.

# Account name typed into the web UI login form.
UI_USERNAME=admin

# Plain-text password. Change this before exposing the UI.
UI_PASSWORD=changeme
