# Web UI login accounts. Copy this file to .env and set at least the first
# account. On startup the app hashes each UI_PASSWORD with PBKDF2, verifies the
# hash, and stores only the hashes in .ui_credentials.json. You never run a
# hashing command yourself.

# Account name typed into the web UI login form. Do not use a colon (:), which
# HTTP Basic authentication reserves between the name and password.
UI_USERNAME=admin

# Plain-text password. Change this before exposing the UI.
UI_PASSWORD=changeme

# Optional second and third accounts. Every account can do the same things;
# they exist to give separate people separate passwords. Leave a slot blank to
# skip it, set both values to use it, and keep the account names different.
UI_USERNAME_2=
UI_PASSWORD_2=
UI_USERNAME_3=
UI_PASSWORD_3=

# Numeric owner for Docker-created files on the host. Run `id -u` and `id -g`
# on the Docker host and replace these defaults when either result differs.
HOST_UID=1000
HOST_GID=1000
