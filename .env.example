# Web UI login. Leave both blank for no login: anyone who can reach the page
# can use it, which suits a home network. Set both to require a password. On
# startup the app hashes each UI_PASSWORD with PBKDF2 and stores only the
# hashes in .ui_credentials.json; you never run a hashing command yourself.

# Account name typed into the login form. Do not use a colon (:), which HTTP
# Basic authentication reserves between the name and password.
UI_USERNAME=

# Plain-text password.
UI_PASSWORD=

# Optional second and third accounts. Every account can do the same things;
# they exist to give separate people separate passwords. Leave a slot blank to
# skip it, set both values to use it, and keep the account names different.
UI_USERNAME_2=
UI_PASSWORD_2=
UI_USERNAME_3=
UI_PASSWORD_3=

# Numeric owner for Docker-created files on the host. Run `id -u` and `id -g`
# on the Docker host and replace these defaults when either result differs.
HOST_UID=1000
HOST_GID=1000
